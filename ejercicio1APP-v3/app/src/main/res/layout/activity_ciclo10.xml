<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Ciclo10">

    <TextView
        android:id="@+id/txvResultadoFor10"
        android:layout_width="112dp"
        android:layout_height="30dp"
        android:layout_marginStart="21dp"
        android:layout_marginTop="56dp"
        android:text="Resultado For"
        app:layout_constraintStart_toEndOf="@+id/btnFor10"
        app:layout_constraintTop_toBottomOf="@+id/txvResultadoDoWhile" />

    <TextView
        android:id="@+id/txvResultadoDoWhile"
        android:layout_width="124dp"
        android:layout_height="28dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="48dp"
        android:text="Resultado Do While"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvResultadoWile" />

    <Button
        android:id="@+id/btnFor10"
        android:layout_width="99dp"
        android:layout_height="49dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="40dp"
        android:text="For 10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDoWhile10" />

    <TextView
        android:id="@+id/textView29"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="156dp"
        android:layout_marginTop="92dp"
        android:text="Ciclo 10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnWhile10"
        android:layout_width="97dp"
        android:layout_height="47dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="64dp"
        android:text="While"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView29" />

    <Button
        android:id="@+id/btnDoWhile10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="28dp"
        android:text="DoWhile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnWhile10" />

    <TextView
        android:id="@+id/txvResultadoWile"
        android:layout_width="118dp"
        android:layout_height="25dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="76dp"
        android:text="Resultado While"
        app:layout_constraintStart_toEndOf="@+id/btnWhile10"
        app:layout_constraintTop_toBottomOf="@+id/textView29" />

    <Button
        android:id="@+id/btnMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="18dp"
        android:text="Menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>